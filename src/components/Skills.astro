---
const categories = [
  {
    icon: '☕',
    title: 'Lenguajes',
    accent: 'cyan',
    tags: ['Java', 'Kotlin', 'C#', 'HTML', 'CSS', 'XML', 'SQL'],
  },
  {
    icon: '📱',
    title: 'Plataformas & Frameworks',
    accent: 'violet',
    tags: ['Android', '.NET 10', 'Blazor WASM', 'ASP.NET Core', 'Astro', 'Spring Boot', 'Hibernate', 'JDBC'],
  },
  {
    icon: '🗄️',
    title: 'Bases de datos',
    accent: 'cyan',
    tags: ['SQL Server', 'MySQL', 'PostgreSQL', 'SQLite', 'PL/SQL'],
  },
  {
    icon: '☁️',
    title: 'Cloud & DevOps',
    accent: 'violet',
    tags: ['AWS', 'EC2', 'S3', 'Git', 'GitHub', 'Docker'],
  },
  {
    icon: '🖥️',
    title: 'Sistemas Operativos',
    accent: 'cyan',
    tags: ['Windows', 'macOS', 'Linux', 'Bash', 'PowerShell'],
  },
  {
    icon: '🛠️',
    title: 'Herramientas',
    accent: 'violet',
    tags: ['Visual Studio', 'VS Code', 'IntelliJ IDEA', 'Android Studio', 'JetBrains Rider', 'DataGrip', 'Postman', 'Figma'],
  },
];
---

<section id="skills">
  <div class="section-label">// 04 — Stack técnico</div>
  <h2>Herramientas &<br/>tecnologías</h2>
  <div class="skills-grid">
    {categories.map((cat, i) => (
      <div class={`skill-category accent-${cat.accent}`} style={`animation-delay: ${i * 0.08}s`}>
        <div class="skill-cat-title">
          <span class="skill-icon">{cat.icon}</span>
          {cat.title}
        </div>
        <div class="skill-tags">
          {cat.tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  section {
    padding: 6rem 4rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-label {
    font-family: 'DM Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  h2 {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    letter-spacing: -0.03em;
    margin-bottom: 3rem;
    line-height: 1.1;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .skill-category {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.6rem;
    position: relative;
    overflow: hidden;
    opacity: 0;
    transform: translateY(24px);
    transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
  }

  .skill-category.visible {
    animation: fadeUp 0.5s ease forwards;
  }

  .skill-category::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    opacity: 0;
    transition: opacity 0.25s;
  }

  .skill-category.accent-cyan::before {
    background: linear-gradient(90deg, var(--accent), transparent);
  }
  .skill-category.accent-violet::before {
    background: linear-gradient(90deg, var(--accent2), transparent);
  }

  .skill-category:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 48px rgba(0,0,0,0.35);
  }
  .skill-category.accent-cyan:hover { border-color: rgba(0,229,255,0.25); }
  .skill-category.accent-violet:hover { border-color: rgba(124,58,237,0.35); }
  .skill-category:hover::before { opacity: 1; }

  .skill-cat-title {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    letter-spacing: -0.01em;
  }

  .skill-icon {
    font-size: 1.1rem;
    line-height: 1;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .tag {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 6px;
    padding: 0.28rem 0.7rem;
    font-family: 'DM Mono', monospace;
    font-size: 0.72rem;
    color: var(--muted);
    transition: all 0.18s;
    cursor: default;
  }

  .accent-cyan .tag:hover {
    background: rgba(0,229,255,0.09);
    border-color: rgba(0,229,255,0.3);
    color: var(--accent);
  }
  .accent-violet .tag:hover {
    background: rgba(124,58,237,0.12);
    border-color: rgba(124,58,237,0.4);
    color: #a78bfa;
  }

  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 1024px) {
    .skills-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    section { padding: 4rem 1.5rem; }
    .skills-grid { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>
