---
---

<section id="inmaypunto">
  <div class="section-label">// 05 — Proyecto freelance</div>
  <h2>Tienda online para<br/><span class="accent">inmaypunto.com</span></h2>

  <div class="inmay-card">
    <div class="inmay-glow"></div>
    <div class="inmay-body">
      <div class="inmay-meta">
        <span class="meta-badge">E-commerce</span>
        <span class="meta-badge violet">WooCommerce</span>
        <a href="https://inmaypunto.com" target="_blank" class="meta-link">inmaypunto.com ↗</a>
      </div>
      <p class="inmay-desc">
        Tienda online completa desarrollada para el negocio de mi madre, dedicado a la venta de
        artículos de punto y lana. Incluye catálogo de productos, carrito de compra, gestión de
        pedidos y pasarela de pago. El objetivo fue dar visibilidad digital al negocio y permitir
        vender sin barreras geográficas.
      </p>
      <div class="inmay-features">
        <div class="feature">
          <span class="feature-icon">🛒</span>
          <div>
            <strong>Catálogo & carrito</strong>
            <p>Productos organizados por categorías con filtros, ficha de producto y carrito funcional.</p>
          </div>
        </div>
        <div class="feature">
          <span class="feature-icon">💳</span>
          <div>
            <strong>Pasarela de pago</strong>
            <p>Integración de métodos de pago seguros para compras online sin fricciones.</p>
          </div>
        </div>
        <div class="feature">
          <span class="feature-icon">📦</span>
          <div>
            <strong>Gestión de pedidos</strong>
            <p>Panel de administración para gestionar stock, pedidos y clientes de forma sencilla.</p>
          </div>
        </div>
        <div class="feature">
          <span class="feature-icon">📱</span>
          <div>
            <strong>Diseño responsive</strong>
            <p>Experiencia de compra adaptada a móvil, tablet y escritorio.</p>
          </div>
        </div>
      </div>
      <div class="inmay-tags">
        <span class="tag">WordPress</span>
        <span class="tag">WooCommerce</span>
        <span class="tag">PHP</span>
        <span class="tag">E-commerce</span>
        <span class="tag">SEO</span>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    padding: 6rem 4rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-label {
    font-family: 'DM Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  h2 {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    letter-spacing: -0.03em;
    margin-bottom: 2.5rem;
    line-height: 1.1;
  }

  .accent { color: var(--accent); }

  .inmay-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  .inmay-card:hover {
    border-color: rgba(0,229,255,0.2);
    box-shadow: 0 24px 64px rgba(0,0,0,0.4);
  }

  .inmay-glow {
    position: absolute;
    top: -1px; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), var(--accent2), transparent);
  }

  .inmay-body {
    padding: 2.5rem;
  }

  .inmay-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .meta-badge {
    background: rgba(0,229,255,0.08);
    border: 1px solid rgba(0,229,255,0.2);
    border-radius: 100px;
    padding: 0.25rem 0.8rem;
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    color: var(--accent);
    letter-spacing: 0.05em;
  }

  .meta-badge.violet {
    background: rgba(124,58,237,0.1);
    border-color: rgba(124,58,237,0.3);
    color: #a78bfa;
  }

  .meta-link {
    margin-left: auto;
    font-family: 'DM Mono', monospace;
    font-size: 0.78rem;
    color: var(--accent);
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .meta-link:hover { opacity: 0.7; }

  .inmay-desc {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 700px;
  }

  .inmay-features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
    margin-bottom: 2rem;
  }

  .feature {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 12px;
    padding: 1.2rem;
    transition: border-color 0.2s;
  }

  .feature:hover { border-color: rgba(0,229,255,0.15); }

  .feature-icon {
    font-size: 1.4rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .feature strong {
    display: block;
    font-family: 'Syne', sans-serif;
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 0.3rem;
    color: var(--text);
  }

  .feature p {
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.5;
    margin: 0;
  }

  .inmay-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .tag {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
    padding: 0.3rem 0.75rem;
    font-family: 'DM Mono', monospace;
    font-size: 0.72rem;
    color: var(--muted);
    transition: all 0.18s;
  }

  .tag:hover {
    background: rgba(0,229,255,0.08);
    border-color: rgba(0,229,255,0.25);
    color: var(--accent);
  }

  @media (max-width: 768px) {
    section { padding: 4rem 1.5rem; }
    .inmay-body { padding: 1.5rem; }
    .inmay-features { grid-template-columns: 1fr; }
    .meta-link { margin-left: 0; }
  }
</style>
