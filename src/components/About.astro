---
const stats = [
  { number: '6+', label: 'Lenguajes de programación' },
  { number: 'AWS', label: 'Certified Cloud Foundations' },
  { number: '3', label: 'Sistemas operativos dominados' },
  { number: 'DAM', label: 'Titulado Superior' },
];

const certs = [
  {
    icon: '☁️',
    title: 'AWS Academy Graduate — Cloud Foundations',
    desc: 'Amazon Web Services · Fundamentos de cloud, arquitectura AWS, seguridad y precios.',
    badge: 'AWS Academy',
  },
  {
    icon: '🎓',
    title: 'Técnico Superior en DAM',
    desc: 'Ciclo Formativo de Grado Superior · Programación, BBDD, sistemas y despliegue de apps.',
    badge: 'Título Oficial',
  },
  {
   icon: '🖥️',
    title: 'Técnico en Sistemas Microinformáticos y Redes',
    desc: 'Ciclo Formativo de Grado Medio · Hardware, redes, administración de sistemas y soporte técnico.',
    badge: 'Título Oficial',
  },
  {
    icon: '📱',
    title: 'Desarrollo Android con Kotlin',
    desc: 'Apps móviles nativas, MVVM, Jetpack Compose, Room y Retrofit.',
    badge: 'Formación',
  },
];
---

<section id="sobre-mi">
  <div class="section-label">// 01 — Sobre mí</div>
  <div class="about-grid">
    <div class="about-text">
      <h2>Código limpio,<br/>soluciones reales.</h2>
      <p>
        Soy Rodrigo, desarrollador de <strong>Orihuela, Alicante</strong>, graduado en
        <strong>Desarrollo de Aplicaciones Multiplataforma</strong>. Me apasiona construir
        software completo: desde la lógica del backend hasta la interfaz que ve el usuario final.
      </p>
      <p>
        Disfruto tanto diseñando una <strong>API robusta</strong> como dándole forma a una
        <strong>interfaz que funcione de verdad</strong>. Ver un proyecto cobrar vida de principio
        a fin es lo que me engancha al desarrollo.
      </p>
      <p>
        Mi objetivo es claro: incorporarme a un equipo donde pueda crecer, aportar desde el primer día
        y convertirme en el <strong>mejor desarrollador</strong> que pueda ser.
      </p>
    </div>
    <div class="about-stats">
      {stats.map(s => (
        <div class="stat-card">
          <div class="stat-number">{s.number}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<div class="section-divider"></div>

<section id="certificaciones">
  <div class="section-label">// 02 — Certificaciones</div>
  <h2>Formación &<br/>certificaciones</h2>
  {certs.map(c => (
    <div class="cert-card">
      <div class="cert-icon">{c.icon}</div>
      <div class="cert-info">
        <h3>{c.title}</h3>
        <p>{c.desc}</p>
      </div>
      <div class="cert-badge">{c.badge}</div>
    </div>
  ))}
</section>

<style>
  section {
    padding: 6rem 4rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-label {
    font-family: 'DM Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  h2 {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    letter-spacing: -0.03em;
    margin-bottom: 3rem;
    line-height: 1.1;
  }

  /* ABOUT */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .about-text p {
    color: var(--muted);
    margin-bottom: 1.2rem;
    font-size: 1.05rem;
  }
  .about-text p strong { color: var(--text); font-weight: 500; }

  .about-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .stat-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    transition: border-color 0.2s, transform 0.2s;
  }
  .stat-card:hover {
    border-color: rgba(0,229,255,0.3);
    transform: translateY(-3px);
  }

  .stat-number {
    font-family: 'Syne', sans-serif;
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--accent);
    line-height: 1;
  }
  .stat-label {
    font-size: 0.82rem;
    color: var(--muted);
    margin-top: 0.4rem;
  }

  /* CERTS */
  .cert-card {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.8rem;
    margin-bottom: 1rem;
    transition: all 0.2s;
  }
  .cert-card:hover {
    border-color: rgba(0,229,255,0.25);
    transform: translateX(6px);
  }

  .cert-icon {
    width: 52px; height: 52px;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(0,229,255,0.15), rgba(124,58,237,0.15));
    border: 1px solid rgba(0,229,255,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .cert-info h3 {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 0.3rem;
  }
  .cert-info p { color: var(--muted); font-size: 0.88rem; }

  .cert-badge {
    margin-left: auto;
    background: rgba(0,229,255,0.08);
    border: 1px solid rgba(0,229,255,0.2);
    border-radius: 100px;
    padding: 0.3rem 0.9rem;
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    color: var(--accent);
    letter-spacing: 0.05em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    section { padding: 4rem 1.5rem; }
    .about-grid { grid-template-columns: 1fr; gap: 2rem; }
    .cert-card { flex-wrap: wrap; }
    .cert-badge { margin-left: 0; }
  }
</style>
